(set-logic ALL)
(declare-const k Int)
(declare-fun C () (_ BitVec k))
(declare-fun %b () (_ BitVec k))
(declare-fun %a () (_ BitVec k))
(assert (and (= (bvand C (bvadd C (int_to_pbv k 1))) (int_to_pbv k 0)) (not (= (and (bvult %a C) (bvult %b C)) (bvult (bvor %a %b) C))) (not (= C (int_to_pbv k 0)))))
(check-sat)