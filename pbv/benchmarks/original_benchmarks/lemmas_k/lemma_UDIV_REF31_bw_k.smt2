(set-logic ALL)
(declare-const k Int)
(declare-const x (_ BitVec k))
(declare-const s (_ BitVec k))
(declare-const t (_ BitVec k))
(define-fun lemma_UDIV_REF31 ((x (_ BitVec k)) (s (_ BitVec k)) (t (_ BitVec k))) Bool (distinct x (bvadd t (bvadd (int_to_pbv k 1) (bvshl (int_to_pbv k 1) x)))))
(assert (= t (bvudiv x s)))
(assert (not (lemma_UDIV_REF31 x s t)))
