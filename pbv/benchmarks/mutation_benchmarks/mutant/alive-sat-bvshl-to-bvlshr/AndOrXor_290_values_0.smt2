(set-logic ALL)
(declare-const k Int)
(declare-fun C2 () (_ BitVec k))
(declare-fun %X () (_ BitVec k))
(declare-fun C1 () (_ BitVec k))
(assert (and (bvsle C1 C2) (= C1 (bvlshr (int_to_pbv k 1) (bvsub (int_to_pbv k k) (int_to_pbv k 1)))) (not (= C1 C2)) (not (= (or (bvslt %X C1) (bvsge %X C2)) (bvsgt %X (bvsub C2 (int_to_pbv k 1)))))))
(check-sat)