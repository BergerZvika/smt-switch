(set-logic ALL)
(declare-const k Int)
(declare-fun C1 () (_ BitVec k))
(declare-fun %a () (_ BitVec k))
(declare-fun C2 () (_ BitVec k))
(assert (and (bvult C1 C2) (= C1 (bvadd C2 (int_to_pbv k 1))) (not (= (and (not (= %a C1)) (not (= %a C2))) (bvugt (bvadd %a (bvneg C1)) (int_to_pbv k 1))))))
(check-sat)